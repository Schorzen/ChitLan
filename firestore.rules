rules_version = '2';

// ChitLan — Firestore security rules.
//
// Paste this into Firebase Console > Firestore Database > Rules, or deploy
// with the Firebase CLI (`firebase deploy --only firestore:rules`).
//
// Known trade-offs (documented on purpose, not oversights):
// - `users` reads are open to any signed-in user because the online-counter
//   query (presence.js) needs to scan lastActive across everyone. This
//   exposes profile fields (not auth credentials) to other members.
// - `publicMessages` deletes are open to any signed-in user because the
//   client-side "prune oldest message past 1000" logic (chat.js) runs on
//   whoever happens to send the 1001st message, not just admins.
// - Location verification (`verifiedLocation`) is set by the client after
//   a geolocation check — Firestore rules can't independently confirm GPS,
//   so a technically-savvy user could bypass it client-side. A Cloud
//   Function cross-checking IP geolocation would close this gap if it
//   ever matters at your scale.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ---- Users ----
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.isAdmin == false
        && request.resource.data.isBlocked == false;
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isBlocked'])
      );
      allow delete: if false;

      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isOwner(userId) || isAdmin();
      }
    }

    // ---- Public Chat ----
    match /publicMessages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && (!('replyTo' in request.resource.data) || request.resource.data.replyTo.text.size() <= 200);
      allow update: if isSignedIn()
        // Only the `reactions` field may change at all — text/sender/etc. stay locked.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        // Within reactions, only YOUR OWN key may change — you can react to
        // anyone's message, but never touch someone else's reaction entry.
        && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if isSignedIn(); // see note above re: message-cap pruning
    }

    match /meta/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ---- RandomChat ----
    match /randomQueue/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /randomRooms/{roomId} {
      allow create: if isSignedIn()
        && (request.resource.data.userA == request.auth.uid || request.resource.data.userB == request.auth.uid);
      allow read, update, delete: if isSignedIn()
        && (resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid);

      match /messages/{msgId} {
        function inRoom() {
          let room = get(/databases/$(database)/documents/randomRooms/$(roomId)).data;
          return room.userA == request.auth.uid || room.userB == request.auth.uid;
        }
        allow read, delete: if isSignedIn() && inRoom();
        allow create: if isSignedIn() && inRoom() && request.resource.data.senderId == request.auth.uid;
        allow update: if false;
      }
    }

    // ---- Community Feed ----
    match /feedPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.type in ['question', 'chismis'];
      // Anyone can bump replyCount (any reply, from anyone, increments the
      // shared counter) and set their own reaction — nothing else about a
      // post can change after it's created, and within reactions, only
      // your own key may ever change (same model as chat message reactions).
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'reactions'])
        && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]);
      // The author can delete their own post any time. Anyone else can
      // only delete it once it's genuinely past expiresAt (checked against
      // Firestore's own server time) — this is what lets any active
      // visitor clean up expired posts for the whole community without
      // opening the door to deleting someone else's post early.
      allow delete: if isSignedIn()
        && (resource.data.authorId == request.auth.uid || resource.data.expiresAt < request.time);

      match /replies/{replyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300;
        allow update: if false;
        allow delete: if isSignedIn()
          && (
            resource.data.authorId == request.auth.uid
            || get(/databases/$(database)/documents/feedPosts/$(postId)).data.expiresAt < request.time
          );
      }
    }

    // ---- Private Messages ----
    // A whole 1:1 conversation (both participants + every message) lives
    // in ONE doc here, not a subcollection — see the comment at the top
    // of pm.js for why that matters for the 24h auto-delete to actually
    // erase everything, not just the parent doc.
    //
    // Documented trade-off, same spirit as the ones above: once both
    // participants can write this doc, either one can technically rewrite
    // or delete the OTHER's past messages within their own shared
    // conversation — these rules tightly validate the newly appended
    // message, not the full history array. Given only the two
    // participants ever see this data, that's the same level of trust any
    // real messaging app already places in a "delete for me" action, not
    // a hole that exposes anything to a third party. Blocking is enforced
    // client-side only (pm.js / page-dm.js), consistent with how
    // `publicMessages` already handles it above.
    match /privateMessages/{convId} {
      // `resource == null` matters: opening a brand-new conversation reads a
      // doc that doesn't exist yet, and without this the rule errors on
      // `resource.data` and denies the read, leaving the thread stuck loading.
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.participants);

      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.messages.size() == 1
        && request.resource.data.messages[0].senderId == request.auth.uid
        && request.resource.data.messages[0].text is string
        && request.resource.data.messages[0].text.size() > 0
        && request.resource.data.messages[0].text.size() <= 500;

      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages', 'expiresAt', 'lastSeenBy'])
        && request.resource.data.lastSeenBy.diff(resource.data.get('lastSeenBy', {})).affectedKeys().hasOnly([request.auth.uid])
        && (
          // marking seen (messages/expiresAt untouched) ...
          request.resource.data.messages == resource.data.messages
          // ...or exactly one new message appended, authored by you
          || (
            request.resource.data.messages.size() == resource.data.messages.size() + 1
            && request.resource.data.messages[resource.data.messages.size()].senderId == request.auth.uid
            && request.resource.data.messages[resource.data.messages.size()].text is string
            && request.resource.data.messages[resource.data.messages.size()].text.size() > 0
            && request.resource.data.messages[resource.data.messages.size()].text.size() <= 500
          )
        );

      // Native Firestore TTL deletions (see README.md) are carried out by
      // Firestore's own backend service and are NOT subject to security
      // rules at all — this `delete` rule only governs the app's optional
      // "Delete conversation" button, not the automatic 24h expiry.
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;
    }

    // ---- Reports ----
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ---- Daily Question ----
    match /dailyQuestions/{dateKey} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- Trending Topics ----
    match /trendingTopics/{topicId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
